# Copy this file to .env and adjust values for your environment.
#
# VITE_API_BASE_URL is used by the Axios client.
# During development the Vite proxy (vite.config.ts) routes /api calls to the
# backend automatically, so this variable is only needed for production builds.
#
# NOTE: All variables prefixed with VITE_ are bundled into the client-side JS.
#       Never put secrets or private keys here.

VITE_API_BASE_URL=http://localhost:8000/api
